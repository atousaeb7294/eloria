# Public URLs
NEXT_PUBLIC_SITE_URL=https://eloriagallery.ir
ELORIA_ALLOWED_ORIGINS=https://eloriagallery.ir,https://www.eloriagallery.ir

# Database — insert provider values; never commit this completed file
DATABASE_URL=postgresql://USER:PASSWORD@POOL_HOST:PORT/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:PORT/DATABASE?sslmode=require
DATABASE_SSL_MODE=require

# Admin — generate locally with the provided npm scripts
ELORIA_ADMIN_USERNAME=admin
ELORIA_ADMIN_PASSWORD_HASH=GENERATE_WITH_npm_run_admin_password-hash
ELORIA_ADMIN_SESSION_SECRET=GENERATE_WITH_npm_run_admin_secret
ELORIA_ADMIN_SESSION_VERSION=2
ELORIA_ADMIN_TOTP_SECRET=GENERATE_WITH_npm_run_admin_totp-secret
# Do not define ELORIA_ADMIN_PASSWORD when the hash above exists.

# Customer authentication and email
ELORIA_CUSTOMER_AUTH_ENABLED=true
RESEND_API_KEY=REPLACE_WITH_RESEND_KEY
ELORIA_EMAIL_FROM=Eloria <login@eloriagallery.ir>
ELORIA_CUSTOMER_AUTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_WITH_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_SECRET_KEY
ELORIA_SUPPORT_TURNSTILE_REQUIRED=true

# Store features — enable gradually after production smoke tests
ELORIA_COMMERCE_ENABLED=true
ELORIA_DYNAMIC_PRICING_ENABLED=true
ELORIA_PAYMENT_ENABLED=false
ELORIA_SUPPORT_ENABLED=true
ELORIA_SUPPORT_CHAT_ENABLED=true
ELORIA_CUSTOMER_WATCHES_ENABLED=true
ELORIA_CONTENT_AUTOPILOT_ENABLED=false
ELORIA_CONTENT_AUTOPILOT_DAILY_LIMIT=1
ELORIA_MEASUREMENT_ENABLED=false

# Operational secrets
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ELORIA_HEALTH_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ELORIA_TRACKING_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
ELORIA_SUPPORT_CHAT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_VALUE
