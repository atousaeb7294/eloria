{
  "name": "neweloria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint",
    "test:visual": "playwright test",
    "admin:secret": "node -e \"console.log(require('crypto').randomBytes(48).toString('hex'))\"",
    "check:env": "tsx scripts/check-production-env.ts",
    "audit:security": "tsx scripts/security-audit.ts",
    "verify": "npm run lint && npm run build && npm run test:visual && npm run audit:security",
    "postinstall": "prisma generate",
    "test:pricing": "tsx scripts/test-pricing-engine.ts && tsx scripts/test-metal-rate-freshness.ts && tsx scripts/test-metal-rate-sale-policy.ts && tsx scripts/test-brs-derived-rate-timestamp.ts && tsx scripts/test-metal-price-write-decision.ts",
    "stock:sync": "tsx scripts/sync-product-stock.ts",
    "check:inventory": "tsx scripts/check-inventory-consistency.ts",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "start:production": "node scripts/start-production.mjs",
    "admin:totp-secret": "node scripts/generate-totp-secret.mjs",
    "test:tokens": "tsx scripts/test-signed-tokens.ts",
    "test:commerce": "tsx scripts/test-commerce-database.ts",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "verify:full": "npm run lint && npm run build && npm run audit:security && npm run test:tokens && npm run test:pricing && npm run test:commerce && npm run test:visual",
    "start:next": "next start",
    "secrets:generate": "node scripts/generate-production-secrets.mjs",
    "db:preflight": "tsx scripts/preflight-hardening-data.ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "prisma db seed",
    "test:e2e": "playwright test",
    "verify:ci": "npm run typecheck && npm run lint && npm run test:tokens && npm run test:pricing && npm run test:commerce && npm run build && npm run test:e2e && npm run audit:security",
    "cron:expired-orders": "node scripts/run-cron-once.mjs expired-orders",
    "cron:metal-prices": "node scripts/run-cron-once.mjs metal-prices",
    "cron:security-alerts": "node scripts/run-cron-once.mjs security-alerts",
    "db:repair-existing": "powershell -ExecutionPolicy Bypass -File scripts/repair-existing-database.ps1",
    "db:verify": "tsx scripts/verify-database-hardening.ts",
    "pricing:seed": "tsx scripts/seed-pricing-policies.ts",
    "metal:sync": "tsx scripts/sync-metal-prices.ts",
    "metal:diagnose": "tsx scripts/diagnose-metal-prices.ts",
    "metal:diagnose-sync": "tsx scripts/diagnose-metal-prices.ts --sync",
    "metal:set-manual": "tsx scripts/set-manual-metal-prices.ts",
    "metal:install-windows-task": "powershell -ExecutionPolicy Bypass -File scripts/install-windows-metal-sync-task.ps1",
    "test:customer": "tsx scripts/test-customer-account.ts",
    "check:customer-env": "tsx scripts/check-customer-production-env.ts",
    "test:shipping": "tsx scripts/test-shipping.ts",
    "check:storefront-env": "tsx scripts/check-storefront-production-env.ts",
    "test:security-alerts": "tsx scripts/test-security-events.ts && tsx scripts/test-security-alert-outbox.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
