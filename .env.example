# ============================================================
# ELORIA Production Environment Contract
# Audited hardening pack - 2026-08-16
# Never commit a real .env file.
# ============================================================

# ---------- PostgreSQL / Supabase ----------
# Runtime should normally use a pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE"
# DIRECT_URL is reserved for Prisma migrations/admin tooling.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE"
DATABASE_SSL_MODE="verify-full"
DATABASE_POOL_MAX="5"
DATABASE_CONNECTION_TIMEOUT_MS="8000"
DATABASE_IDLE_TIMEOUT_MS="15000"
DATABASE_MAX_LIFETIME_SECONDS="120"
DATABASE_STATEMENT_TIMEOUT_MS="15000"

# ---------- Public canonical origin ----------
# Must be the final HTTPS domain in Production.
NEXT_PUBLIC_SITE_URL="https://YOUR_FINAL_DOMAIN.example"
ELORIA_INTERNAL_BASE_URL="https://YOUR_FINAL_DOMAIN.example"
# Optional additional exact origins, comma separated. Leave empty unless needed.
ELORIA_ALLOWED_ORIGINS=""

# ---------- Explicit feature gates ----------
# Production NEVER infers these from whether a credential happens to be present.
ELORIA_COMMERCE_ENABLED="false"
ELORIA_CUSTOMER_AUTH_ENABLED="false"
ELORIA_DYNAMIC_PRICING_ENABLED="false"
ELORIA_PAYMENT_ENABLED="false"
ELORIA_SUPPORT_ENABLED="true"
# Privacy-first measurement remains off until the privacy text is reviewed.
ELORIA_MEASUREMENT_ENABLED="false"
# When enabled, customers can opt in to in-account price-drop/restock alerts.
ELORIA_CUSTOMER_WATCHES_ENABLED="true"
# Creates at most one factual product article draft per day; never publishes it.
ELORIA_CONTENT_AUTOPILOT_ENABLED="true"
ELORIA_CONTENT_AUTOPILOT_DAILY_LIMIT="1"

# Keep legal pages noindex until legal text, seller identity and compliance sign-off are complete.
ELORIA_LEGAL_PAGES_INDEX="false"

# ---------- Legal seller identity ----------
# Required before ELORIA_COMMERCE_ENABLED=true or ELORIA_LEGAL_PAGES_INDEX=true.
# Use the real licensed seller/business details. Do not use placeholders in Production.
ELORIA_LEGAL_SELLER_NAME=""
ELORIA_LEGAL_BUSINESS_ADDRESS=""
# At least one of phone/email is required when Commerce or legal indexing is enabled.
ELORIA_LEGAL_SUPPORT_PHONE=""
ELORIA_LEGAL_SUPPORT_EMAIL=""

# ---------- Admin ----------
ELORIA_ADMIN_USERNAME="admin"
# Production contract requires >= 20 chars.
ELORIA_ADMIN_PASSWORD="CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD"
ELORIA_ADMIN_SESSION_SECRET="PASTE_RANDOM_SECRET_AT_LEAST_48_CHARS"
ELORIA_ADMIN_SESSION_VERSION="1"
# REQUIRED in Production. Generate with: npm run admin:totp-secret
ELORIA_ADMIN_TOTP_SECRET="PASTE_BASE32_TOTP_SECRET"

# ---------- Independent security secrets ----------
CRON_SECRET="PASTE_RANDOM_SECRET_AT_LEAST_48_CHARS"
ELORIA_HEALTH_SECRET="PASTE_DIFFERENT_RANDOM_SECRET_AT_LEAST_48_CHARS"
ELORIA_TRACKING_SECRET="PASTE_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS"
ELORIA_PAYMENT_RECEIPT_SECRET="PASTE_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS"
ELORIA_PAYMENT_START_SECRET="PASTE_DIFFERENT_RANDOM_SECRET_AT_LEAST_48_CHARS"
ELORIA_CUSTOMER_AUTH_SECRET="PASTE_DIFFERENT_RANDOM_SECRET_AT_LEAST_48_CHARS"

# Stable 32-byte Base64 key for Server Actions across replicas/deploys.
# Generate:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="PASTE_32_BYTE_BASE64_KEY"
ELORIA_DEPLOYMENT_ID="release-YYYYMMDD-N"

# ---------- Proxy / rate limiting ----------
ELORIA_TRUST_PROXY="true"
# cloudflare or generic. generic must only be used behind a protected reverse proxy.
ELORIA_PROXY_PROVIDER="cloudflare"
ELORIA_RATE_LIMIT_FAILURE_MODE="closed"

# ---------- Cloudflare Turnstile ----------
# Required when Commerce, Customer Auth, or protected Support form is enabled.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
ELORIA_SUPPORT_TURNSTILE_REQUIRED="true"

# ---------- Product image storage ----------
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="PASTE_SUPABASE_SERVICE_ROLE_KEY"
ELORIA_STORAGE_BUCKET="product-images"
# Optional additional image hosts. Prefer leaving this empty and serving product
# media only from the configured Supabase project.
ELORIA_ALLOWED_IMAGE_HOSTS=""

# ---------- Metal-rate source (BRS) ----------
BRS_API_KEY="PASTE_BRS_API_KEY"
# Production overrides, if used, are restricted to HTTPS Api.BrsApi.ir.
# BRS_GOLD_API_URL="https://Api.BrsApi.ir/Market/Gold_Currency_Pro.php"
# BRS_COMMODITY_API_URL="https://Api.BrsApi.ir/Market/Commodity.php"
# BRS_GOLD_SYMBOL="IR_GOLD_18K"
# BRS_USD_SYMBOL="USD"
# BRS_SILVER_SYMBOL="XAGUSD"

METAL_PRICE_STALE_AFTER_MINUTES="15"
METAL_PRICE_READ_CACHE_MS="5000"
METAL_PRICE_READ_STALE_FALLBACK_MS="60000"

# Dynamic-rate financial circuit breaker.
# Re-evaluate these operational limits periodically; do not silently widen them.
ELORIA_GOLD_RATE_MIN_TOMAN="1000000"
ELORIA_GOLD_RATE_MAX_TOMAN="1000000000"
ELORIA_SILVER_RATE_MIN_TOMAN="1000"
ELORIA_SILVER_RATE_MAX_TOMAN="10000000"
ELORIA_GOLD_RATE_MAX_DEVIATION_PERCENT="12"
ELORIA_SILVER_RATE_MAX_DEVIATION_PERCENT="20"

# ---------- Shipping ----------
ELORIA_SHIPPING_FLAT_TOMAN="0"
# Optional threshold. Empty means no threshold rule.
# ELORIA_FREE_SHIPPING_FROM_TOMAN="5000000"

# ---------- ZarinPal ----------
# Required only when ELORIA_PAYMENT_ENABLED=true.
# ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
# Production endpoints are hard-restricted to the official host.
# ZARINPAL_API_BASE="https://payment.zarinpal.com/pg/v4/payment"
# ZARINPAL_STARTPAY_BASE="https://payment.zarinpal.com/pg/StartPay"
ZARINPAL_REQUEST_TIMEOUT_MS="5000"

# ---------- SMS / Customer OTP ----------
# Required when ELORIA_CUSTOMER_AUTH_ENABLED=true, or when SMS security alerts are used.
# KAVENEGAR_API_KEY=""
# KAVENEGAR_SENDER=""
ELORIA_CUSTOMER_SESSION_DAYS="30"
ELORIA_CUSTOMER_OTP_TTL_MINUTES="5"

# Development only. NEVER set in Production.
# ELORIA_CUSTOMER_OTP_DEV_CODE="123456"

# ---------- Security alert outbox ----------
ELORIA_SECURITY_ALERT_MIN_SEVERITY="HIGH"
ELORIA_SECURITY_ALERT_COOLDOWN_SECONDS="300"
# Configure at least one real channel in Production.
# ELORIA_SECURITY_ALERT_MOBILE="09xxxxxxxxx"
# ELORIA_SECURITY_ALERT_WEBHOOK_URL="https://security-alerts.example/webhook"

# ---------- Customer support ----------
# Configure at least one delivery channel.
# ELORIA_SUPPORT_MOBILE="09xxxxxxxxx"
# HTTPS public endpoint only; localhost/private IPs are rejected.
# ELORIA_SUPPORT_WEBHOOK_URL="https://support.example/webhook"

# ---------- Retention ----------
# Financial order/payment audit records are NOT deleted by this job.
ELORIA_OTP_RETENTION_DAYS="7"
ELORIA_SESSION_RETENTION_DAYS="30"
ELORIA_SECURITY_ALERT_RETENTION_DAYS="90"
ELORIA_SECURITY_EVENT_RETENTION_DAYS="180"
# Consented performance and funnel telemetry has no PII and is pruned automatically.
ELORIA_MEASUREMENT_RETENTION_DAYS="180"
