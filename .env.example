# PostgreSQL / Supabase
# DATABASE_URL باید آدرس Pooler برای Runtime باشد.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE"
# DIRECT_URL اتصال مستقیم برای Prisma Migration است.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE"
DATABASE_SSL_MODE="verify-full"
DATABASE_POOL_MAX="5"
DATABASE_CONNECTION_TIMEOUT_MS="30000"
DATABASE_IDLE_TIMEOUT_MS="600000"

# ELORIA Admin
# حداقل ۱۴ کاراکتر؛ بهتر است ترکیبی و غیرقابل حدس باشد.
ELORIA_ADMIN_PASSWORD="CHANGE_THIS_TO_A_STRONG_PASSWORD"

# با دستور npm run admin:secret تولید شود؛ حداقل ۴۸ کاراکتر.
ELORIA_ADMIN_SESSION_SECRET="PASTE_GENERATED_SECRET_HERE"

# Product image storage in production
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="PASTE_SUPABASE_SERVICE_ROLE_KEY"
ELORIA_STORAGE_BUCKET="product-images"

# Public production URL used in payment callbacks
NEXT_PUBLIC_SITE_URL="https://eloria.example"

# Metal-rate source (BRS)
BRS_API_KEY="PASTE_BRS_API_KEY"
# Optional endpoint/symbol overrides; defaults are defined in src/lib/brs-market.ts
# BRS_GOLD_API_URL=""
# BRS_COMMODITY_API_URL=""
# BRS_GOLD_SYMBOL=""
# BRS_USD_SYMBOL=""
# BRS_SILVER_SYMBOL=""
METAL_PRICE_STALE_AFTER_MINUTES="15"
METAL_PRICE_READ_CACHE_MS="5000"
METAL_PRICE_READ_STALE_FALLBACK_MS="60000"

# Cron routes; invoke them from an external scheduler
CRON_SECRET="PASTE_A_RANDOM_SECRET_WITH_AT_LEAST_48_CHARACTERS"
ELORIA_INTERNAL_BASE_URL="https://eloria.example"

# ZarinPal payment gateway
# ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
# ZARINPAL_API_BASE="https://payment.zarinpal.com/pg/v4/payment"
# ZARINPAL_STARTPAY_BASE="https://payment.zarinpal.com/pg/StartPay"

# Kavenegar SMS
# KAVENEGAR_API_KEY=""
# KAVENEGAR_SENDER=""

# Support delivery (at least one channel)
# ELORIA_SUPPORT_MOBILE="09xxxxxxxxx"
# ELORIA_SUPPORT_WEBHOOK_URL="https://..."

# Shared proxy/IP and optional Cloudflare Turnstile
ELORIA_TRUST_PROXY="true"
# cloudflare or generic; use generic only behind a network-protected reverse proxy
ELORIA_PROXY_PROVIDER="cloudflare"
# Production default is closed. fallback is only appropriate for local development.
ELORIA_RATE_LIMIT_FAILURE_MODE="closed"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

ELORIA_ADMIN_USERNAME="admin"
ELORIA_ADMIN_SESSION_VERSION="1"
# اختیاری؛ با npm run admin:totp-secret تولید شود.
ELORIA_ADMIN_TOTP_SECRET=""
ELORIA_TRACKING_SECRET="PASTE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS"
ELORIA_PAYMENT_RECEIPT_SECRET="PASTE_A_DIFFERENT_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS"
# کلید ثابت ۳۲ بایتی Base64 برای Server Actions در چند Deploy/Replica
# تولید در PowerShell: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY="PASTE_32_BYTE_BASE64_KEY"
ELORIA_DEPLOYMENT_ID="release-2026-08-04"
