# PostgreSQL / Supabase
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ELORIA Admin
# حداقل ۱۲ کاراکتر؛ بهتر است ترکیبی و غیرقابل حدس باشد.
ELORIA_ADMIN_PASSWORD="CHANGE_THIS_TO_A_STRONG_PASSWORD"

# با دستور npm run admin:secret تولید شود؛ حداقل ۳۲ کاراکتر.
ELORIA_ADMIN_SESSION_SECRET="PASTE_GENERATED_SECRET_HERE"

# Product image storage in production
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# ELORIA_STORAGE_BUCKET="product-images"

# Public production URL used in payment callbacks
# NEXT_PUBLIC_SITE_URL="https://eloria.example"

# ZarinPal payment gateway
# ZARINPAL_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
# ZARINPAL_API_BASE="https://payment.zarinpal.com/pg/v4/payment"
# ZARINPAL_STARTPAY_BASE="https://payment.zarinpal.com/pg/StartPay"

# Kavenegar SMS
# KAVENEGAR_API_KEY=""
# KAVENEGAR_SENDER=""

# Support delivery (at least one channel)
# ELORIA_SUPPORT_MOBILE="09xxxxxxxxx"
# ELORIA_SUPPORT_WEBHOOK_URL="https://..."
