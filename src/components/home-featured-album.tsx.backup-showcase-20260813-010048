"use client";

import Link from "next/link";
import {
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";

type FeaturedAlbumItem = {
  slug: string;
  name: string;
  imageUrl: string;
  href: string;
};

type FeaturedResponse = {
  items?: FeaturedAlbumItem[];
};

function getFallbackItems(locale: string): FeaturedAlbumItem[] {
  return [
    {
      slug: "fallback-bracelet",
      name: "Eloria",
      imageUrl: "/images/collections/bracelet.jpg",
      href: `/${locale}/products`,
    },
    {
      slug: "fallback-earring",
      name: "Eloria",
      imageUrl: "/images/collections/earring.jpg",
      href: `/${locale}/products`,
    },
    {
      slug: "fallback-necklace",
      name: "Eloria",
      imageUrl: "/images/collections/necklaces.jfif",
      href: `/${locale}/products`,
    },
  ];
}

export function HomeFeaturedAlbum({
  locale,
}: {
  locale: string;
}) {
  const fallbackItems = useMemo(
    () => getFallbackItems(locale),
    [locale],
  );

  const [items, setItems] =
    useState<FeaturedAlbumItem[]>(
      fallbackItems,
    );

  const [activeIndex, setActiveIndex] =
    useState(0);

  const [paused, setPaused] =
    useState(false);

  const touchStartX =
    useRef<number | null>(null);

  useEffect(() => {
    let cancelled = false;

    async function loadProducts() {
      try {
        const response = await fetch(
          `/api/home-featured-products?locale=${encodeURIComponent(locale)}`,
          {
            cache: "no-store",
          },
        );

        if (!response.ok) {
          return;
        }

        const payload =
          (await response.json()) as FeaturedResponse;

        if (
          cancelled ||
          !Array.isArray(payload.items) ||
          payload.items.length < 2
        ) {
          return;
        }

        setItems(payload.items);
        setActiveIndex(0);
      } catch {
        // Local fallback remains visible.
      }
    }

    void loadProducts();

    return () => {
      cancelled = true;
    };
  }, [locale]);

  useEffect(() => {
    if (
      paused ||
      items.length < 2
    ) {
      return;
    }

    const timer =
      window.setInterval(() => {
        setActiveIndex(
          (current) =>
            (current + 1) %
            items.length,
        );
      }, 2800);

    return () => {
      window.clearInterval(timer);
    };
  }, [
    items.length,
    paused,
  ]);

  function previous() {
    setActiveIndex(
      (current) =>
        (current - 1 + items.length) %
        items.length,
    );
  }

  function next() {
    setActiveIndex(
      (current) =>
        (current + 1) %
        items.length,
    );
  }

  function getPosition(
    index: number,
  ) {
    const length = items.length;

    if (!length) {
      return 99;
    }

    const delta =
      (index -
        activeIndex +
        length) %
      length;

    if (delta === 0) {
      return 0;
    }

    if (delta === 1) {
      return 1;
    }

    if (
      delta ===
      length - 1
    ) {
      return -1;
    }

    return 99;
  }

  return (
    <div
      className="relative mx-auto mt-5 w-full max-w-[920px] select-none"
      onMouseEnter={() =>
        setPaused(true)
      }
      onMouseLeave={() =>
        setPaused(false)
      }
      onFocusCapture={() =>
        setPaused(true)
      }
      onBlurCapture={() =>
        setPaused(false)
      }
      onTouchStart={(event) => {
        touchStartX.current =
          event.touches[0]
            ?.clientX ?? null;
      }}
      onTouchEnd={(event) => {
        if (
          touchStartX.current ===
          null
        ) {
          return;
        }

        const endX =
          event.changedTouches[0]
            ?.clientX;

        if (
          endX === undefined
        ) {
          touchStartX.current =
            null;
          return;
        }

        const distance =
          endX -
          touchStartX.current;

        if (
          Math.abs(distance) >
          45
        ) {
          if (distance > 0) {
            previous();
          } else {
            next();
          }
        }

        touchStartX.current =
          null;
      }}
    >
      <div className="pointer-events-none absolute left-1/2 top-[46%] h-[230px] w-[72%] -translate-x-1/2 -translate-y-1/2 rounded-[50%] bg-[#b7923e]/[0.08] blur-[65px]" />

      <div className="pointer-events-none absolute left-1/2 top-[46%] h-[160px] w-[42%] -translate-x-1/2 -translate-y-1/2 rounded-[50%] bg-[#2e8b68]/[0.12] blur-[55px]" />

      <div className="relative h-[360px] overflow-hidden sm:h-[450px] lg:h-[530px]">
        {items.map(
          (
            item,
            index,
          ) => {
            const position =
              getPosition(index);

            const isActive =
              position === 0;

            if (
              position === 99
            ) {
              return null;
            }

            const positionClass =
              position === 0
                ? "left-1/2 top-2 z-30 w-[66%] -translate-x-1/2 scale-100 opacity-100 sm:w-[52%] lg:w-[43%]"
                : position === -1
                  ? "left-[3%] top-[35px] z-10 w-[48%] -rotate-[4deg] scale-[0.90] opacity-55 blur-[0.3px] sm:left-[8%] sm:w-[38%] lg:left-[12%] lg:w-[32%]"
                  : "right-[3%] top-[35px] z-10 w-[48%] rotate-[4deg] scale-[0.90] opacity-55 blur-[0.3px] sm:right-[8%] sm:w-[38%] lg:right-[12%] lg:w-[32%]";

            return (
              <div
                key={
                  item.slug
                }
                className={`absolute origin-center will-change-[transform,opacity] transition-[transform,opacity,filter,left,right,top,width] duration-[1350ms] ease-[cubic-bezier(0.16,1,0.3,1)] ${positionClass}`}
                aria-hidden={
                  !isActive
                }
              >
                <div className="relative overflow-hidden rounded-[28px] border border-[#d9bb67]/25 bg-[linear-gradient(145deg,rgba(11,46,35,.92),rgba(2,13,10,.96))] p-[5px] shadow-[0_28px_90px_rgba(0,0,0,.48),0_0_45px_rgba(202,168,83,.08),inset_0_1px_0_rgba(255,255,255,.06)]">
                  <div className="pointer-events-none absolute inset-[8px] z-20 rounded-[21px] border border-[#e3c67b]/10" />

                  <div className="relative aspect-[4/5] overflow-hidden rounded-[23px] bg-[#03120d]">
                    <Link
                      href={
                        item.href
                      }
                      tabIndex={
                        isActive
                          ? 0
                          : -1
                      }
                      className={
                        isActive
                          ? "block h-full w-full"
                          : "pointer-events-none block h-full w-full"
                      }
                    >
                      {/* eslint-disable-next-line @next/next/no-img-element -- product images can be local or admin-hosted remote URLs */}
                      <img
                        src={
                          item.imageUrl
                        }
                        alt={
                          item.name
                        }
                        draggable={
                          false
                        }
                        className="h-full w-full object-cover transition-transform duration-[1800ms] ease-out hover:scale-[1.035]"
                      />

                      <div className="pointer-events-none absolute inset-0 bg-[linear-gradient(180deg,transparent_52%,rgba(1,10,7,.16)_67%,rgba(1,9,6,.92)_100%)]" />

                      <div className="pointer-events-none absolute inset-x-0 bottom-0 px-5 pb-5 pt-12 text-center sm:px-7 sm:pb-7">
                        <div className="mx-auto mb-3 h-px w-11 bg-[linear-gradient(90deg,transparent,#d9bb67,transparent)]" />

                        <p className="line-clamp-1 text-[11px] font-medium tracking-[0.04em] text-[#f0ddb0]/90 sm:text-[13px]">
                          {
                            item.name
                          }
                        </p>
                      </div>
                    </Link>
                  </div>

                  {isActive && (
                    <>
                      <span className="pointer-events-none absolute -left-px top-[18%] h-[28%] w-px bg-[linear-gradient(180deg,transparent,#d6b45d,transparent)]" />

                      <span className="pointer-events-none absolute -right-px bottom-[17%] h-[28%] w-px bg-[linear-gradient(180deg,transparent,#d6b45d,transparent)]" />
                    </>
                  )}
                </div>
              </div>
            );
          },
        )}
      </div>

      <div className="relative z-40 -mt-1 flex items-center justify-center gap-5">
        <button
          type="button"
          onClick={previous}
          aria-label="Previous featured product"
          className="grid h-9 w-9 place-items-center rounded-full border border-[#d7b860]/25 bg-[#061b14]/75 text-[#d9bd6d]/80 shadow-[0_10px_35px_rgba(0,0,0,.25)] backdrop-blur-md transition duration-500 hover:border-[#ebcf7c]/55 hover:bg-[#0a2a1e] hover:text-[#f2d98e]"
        >
          <span
            aria-hidden="true"
            className="text-lg leading-none"
          >
            ‹
          </span>
        </button>

        <div className="flex min-w-[72px] items-center justify-center gap-2">
          {items.map(
            (
              item,
              index,
            ) => (
              <button
                key={
                  `dot-${item.slug}`
                }
                type="button"
                onClick={() =>
                  setActiveIndex(
                    index,
                  )
                }
                aria-label={`Show featured product ${index + 1}`}
                className={
                  index ===
                  activeIndex
                    ? "h-[5px] w-7 rounded-full bg-[#d6b65f] shadow-[0_0_13px_rgba(214,182,95,.38)] transition-all duration-500"
                    : "h-[5px] w-[5px] rounded-full bg-[#d6b65f]/25 transition-all duration-500 hover:bg-[#d6b65f]/55"
                }
              />
            ),
          )}
        </div>

        <button
          type="button"
          onClick={next}
          aria-label="Next featured product"
          className="grid h-9 w-9 place-items-center rounded-full border border-[#d7b860]/25 bg-[#061b14]/75 text-[#d9bd6d]/80 shadow-[0_10px_35px_rgba(0,0,0,.25)] backdrop-blur-md transition duration-500 hover:border-[#ebcf7c]/55 hover:bg-[#0a2a1e] hover:text-[#f2d98e]"
        >
          <span
            aria-hidden="true"
            className="text-lg leading-none"
          >
            ›
          </span>
        </button>
      </div>

      <div
        aria-hidden="true"
        className="mx-auto mt-5 flex max-w-[360px] items-center gap-3 opacity-50"
      >
        <span className="h-px flex-1 bg-[linear-gradient(90deg,transparent,rgba(213,180,96,.48))]" />

        <span className="h-[5px] w-[5px] rotate-45 border border-[#d5b460]/65" />

        <span className="h-px flex-1 bg-[linear-gradient(90deg,rgba(213,180,96,.48),transparent)]" />
      </div>
    </div>
  );
}